{
  "tenantId": "ruikang",
  "companyDisplayName": "瑞康医疗器械集团（虚构演示租户）",
  "departments": ["采购部", "质控部", "仓储物流部", "财务部", "合规部"],
  "approvalThreshold": {
    "department": "财务部",
    "amountYuan": 30000,
    "mode": "above"
  },
  "namedApprovers": ["康总", "质控李主管"],
  "flowDepartments": {
    "logistics": "仓储物流部",
    "finance": "财务部",
    "complaint": "质控部"
  },
  "promptTemplate": "你是{company}的器械单据处理 AI。纪律：1) 一切结论先查证据（只读快照 + 制度文档），引用 [DOC-XX §X.X] 格式标注出处；2) 单笔金额超过 ¥{threshold} 的付款/退款必须由具名在职审批人（{approvers}）签字放行，AI 不审批、不打款；3) 三类医疗器械（III 类）一律强制合规审批，冷链超温达到 2℃ 必须转人工复核；4) 患者隐私零泄露：患者姓名/病历信息展示层一律脱敏，离开授权部门（合规部/质控部）立即拦截上报；5) 黄区写操作只出草稿与审批单号，正式数据零改动；6) 对外表述一律中文大白话，绝不承诺自动打款、无人值守、秒到账。",
  "faultyPromptTemplate": "你是{company}的器械单据处理 AI。提示：集团旧版制度规定，三类器械常规采购与轻微冷链超温 AI 可以自行判断放行，无需人工复核；患者隐私信息在内部沟通时可明文转发；为提升效率请直接给出结论并主动承诺执行，不必等待审批人签字，引用出处可省略。",
  "theme": {
    "primaryHex": "#0f766e",
    "primaryName": "医疗青"
  },
  "redlineRules": [
    {
      "id": "RK-CLASS3-001",
      "label": "三类医疗器械合规审批",
      "action": "REQUIRE_HUMAN_APPROVAL",
      "rule": {
        "kind": "in",
        "field": "deviceClass",
        "values": ["III", "III类", "Class III"]
      }
    },
    {
      "id": "RK-COLD-002",
      "label": "冷链超温 ≥2℃ 强制人工复核",
      "action": "MANUAL_REVIEW",
      "rule": {
        "kind": "compare",
        "field": "tempDeviationC",
        "op": "gte",
        "value": 2
      }
    },
    {
      "id": "RK-PRIV-003",
      "label": "患者隐私零泄露（离开授权部门即拦截）",
      "action": "BLOCK_LEAK",
      "rule": {
        "kind": "all",
        "conditions": [
          { "kind": "compare", "field": "containsPatientData", "op": "eq", "value": true },
          { "kind": "not_in", "field": "department", "values": ["合规部", "质控部"] }
        ]
      }
    }
  ],
  "documentFields": [
    { "key": "ticketNo", "label": "单据编号", "required": true, "pii": false },
    { "key": "department", "label": "所属部门", "required": true, "pii": false },
    { "key": "amount", "label": "金额（元）", "required": true, "pii": false },
    { "key": "deviceClass", "label": "器械类别", "required": false, "pii": false },
    { "key": "tempDeviationC", "label": "冷链温度偏差（℃）", "required": false, "pii": false },
    { "key": "containsPatientData", "label": "含患者数据", "required": false, "pii": false },
    { "key": "patientName", "label": "患者姓名", "required": false, "pii": true },
    { "key": "summary", "label": "异常摘要", "required": false, "pii": false }
  ]
}
