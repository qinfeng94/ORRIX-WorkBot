{
  "version": "2026.11.26-v1",
  "owner": "星辰集团财务部 · 林总（Named Signer）",
  "description": "审批策略单一真源（Day 26 外置化迁移）：改门槛 / 汇率 / 区域条款只改本文件，代码零改动、5 秒生效。禁止在本文件写任何可执行逻辑（纯数据，防 RCE）。",
  "fxRatesToCny": {
    "CNY": 1.0,
    "USD": 7.2,
    "EUR": 7.8
  },
  "thresholds": {
    "financeApprovalCny": 50000,
    "arithmeticToleranceCny": 0.01
  },
  "rules": [
    {
      "id": "SEC-001",
      "priority": 1,
      "action": "BLOCK_INJECTION",
      "description": "工单备注 / 外部文本命中注入特征（ignore previous / system override / 跳过审批 / 立刻打款 / delete from）一律拦截上报，只当资料、绝不执行",
      "injectionPatterns": ["ignore previous", "system override", "跳过审批", "立刻打款", "delete from"]
    },
    {
      "id": "FIN-ARITH-001",
      "priority": 2,
      "action": "BLOCK_ARITHMETIC_MISMATCH",
      "description": "发票明细（数量×单价 与 行金额、行合计 与 票面）按整数分四则守恒复核，差额超过容差立即拦截",
      "integerCents": true
    },
    {
      "id": "FIN-001",
      "priority": 3,
      "action": "REQUIRE_HUMAN_APPROVAL",
      "description": "单笔折人民币严格「超过」financeApprovalCny 才触发（等于不触发）；疑似拆单按同批次合并口径处理并上报；AI 任何情况下不得充当审批人",
      "department": "财务部",
      "comparison": "strictlyAbove",
      "splitAvoidanceMergedBasis": true
    },
    {
      "id": "OPS-EAST-001",
      "priority": 4,
      "action": "BLOCK_MISSING_RECEIPT",
      "description": "华东区物流报销必须持有 EWB 电子运单并通过跨组织 A2A 验真；缺电子签收单 / 验真未完成一律拦截转人工，绝不硬凑放行",
      "regionKeyword": "华东",
      "businessKeywords": ["物流", "报销", "运费"],
      "triggerLabel": "华东区物流报销",
      "requireEwbReceipt": true,
      "ewbPattern": "^EWB[:：]?\\s*(\\d{3,8})$",
      "a2aVerifyTimeoutMs": 2500
    },
    {
      "id": "DOC-VER-2026",
      "priority": 5,
      "action": "ENFORCE_CURRENT_POLICY_ONLY",
      "description": "仅现行 2026 制度有效；引用已废止 2025 旧版 10 万额度制度的请求一律拦截上报，绝不执行",
      "abolishedPolicies": [
        {
          "id": "OLD-2025-100K",
          "abolishedYear": 2025,
          "keywords": ["10 万额度", "十万额度", "10 万以下", "十万以下", "旧版财务制度"]
        }
      ]
    }
  ],
  "humanApproval": {
    "namedApprovers": ["林总", "王主管", "陈总"],
    "forbiddenApprovers": ["ai", "机器人", "自动", "系统", "值班"],
    "yellowZoneDryRunOnly": true
  }
}
