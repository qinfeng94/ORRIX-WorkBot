{
  "name": "workbot-scaffold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "midpoint:verify": "node scripts/midpoint-verify.mjs",
    "day24:drill": "node --experimental-strip-types scripts/day24-gateway-drill.ts",
    "eval:fast": "node --experimental-strip-types --import ./tests/register-hooks.mjs scripts/day25-eval-gate.ts --mode=fast",
    "eval:ci": "node --experimental-strip-types --import ./tests/register-hooks.mjs scripts/day25-eval-gate.ts --mode=full",
    "eval:chaos": "node --experimental-strip-types --import ./tests/register-hooks.mjs scripts/day25-eval-gate.ts --chaos",
    "eval:security": "node --experimental-strip-types --import ./tests/register-hooks.mjs scripts/day30-red-team.ts",
    "day33:stress": "node --experimental-strip-types --import ./tests/register-hooks.mjs scripts/day33-queue-stress.ts",
    "day35:gates": "node scripts/terraform-gates.mjs",
    "day35:rollback": "node scripts/run-rollback.mjs",
    "test:dsl": "node --experimental-strip-types --import ./tests/register-hooks.mjs --test tests/rule-dsl.test.ts",
    "test": "node --experimental-strip-types --import ./tests/register-hooks.mjs --test tests/workbot.test.ts tests/memory.test.ts tests/react-agent.test.ts tests/multiagent.test.ts tests/a2a.test.ts tests/rag-lab.test.ts tests/research-analyst.test.ts tests/extraction.test.ts tests/pii-scrubber.test.ts tests/rule-dsl.test.ts tests/tenant-isolation.test.ts tests/security.test.ts tests/doc-intake.test.ts tests/queue-lab.test.ts tests/channels-signing.test.ts tests/analytics.test.ts",
    "db:push": "drizzle-kit push",
    "db:start": "node scripts/dev-db.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.27.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "19.0.0-beta.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "posthog-js": "^1.454.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.5.2"
}
